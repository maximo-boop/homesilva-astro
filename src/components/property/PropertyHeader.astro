---
import { buildTitle, formatPrice, toSlug, toPlural } from "@/scripts/utils.js";

const { p } = Astro.props;

const op = p.operation.toLowerCase();
const type = toPlural(p.type.toLowerCase());
const base = "/propiedades";

const crumbs = [
	{ label: "Inicio", href: "/" },
	{ label: "Propiedades", href: base },
	{ label: p.operation, href: `${base}/${op}` },
	{ label: type, href: `${base}/${op}/${type}`, cap: true },
	{ label: p.locality, href: `${base}/${op}/${type}/${toSlug(p.locality.toLowerCase())}` },
];

const title = p.title || buildTitle(p);
const place = [p.direction, p.barrio, p.locality].filter(Boolean).join(", ");
const price =
	`${p.toPrice ? "Desde " : ""}${formatPrice(p.price, p.currency)}` +
	(p.toPrice ? ` hasta ${formatPrice(p.toPrice, p.currency)}` : "");
---

<div class="flex flex-col gap-6 lg:gap-8">

	<div class="flex items-center justify-between gap-4">
		<nav aria-label="Ruta de navegación" class="min-w-0">
			<ol class="flex items-center gap-2 overflow-x-auto whitespace-nowrap text-[.9rem] text-[var(--textop)] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
				{crumbs.map((c, i) => (
					<li class="flex items-center gap-2">
						{i > 0 && <span aria-hidden="true">/</span>}
						<a
							href={c.href}
							aria-current={i === crumbs.length - 1 ? "page" : undefined}
							class:list={[
								"transition-colors hover:text-[var(--green)]",
								c.cap && "capitalize",
								i === crumbs.length - 1 && "text-[var(--green)]",
							]}
						>
							{c.label}
						</a>
					</li>
				))}
			</ol>
		</nav>

		<button
			type="button"
			id="shared"
			aria-label={`Compartir propiedad ${title}`}
			class="flex shrink-0 cursor-pointer items-center gap-2 bg-[var(--card)] px-4 py-2 text-[.9rem] text-[var(--text2)] transition-colors hover:bg-[var(--moss-pale)]"
		>
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
				<path d="M8 9h-1a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-8a2 2 0 0 0 -2 -2h-1" />
				<path d="M12 14v-11" />
				<path d="M9 6l3 -3l3 3" />
			</svg>
			<span data-share-label>Compartir</span>
		</button>
	</div>

	<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
		<div class="flex max-w-4xl flex-col gap-4">
			<span class="w-fit bg-[var(--moss-light)] px-3 py-1 text-[.9rem] font-medium text-[var(--moss-pale)] [-webkit-text-stroke:0.02em_currentColor]">
				{p.operation} · {p.type}
			</span>
			<h1 class="text-[clamp(1.75rem,3.5vw,3.25rem)] font-medium leading-[1.2] tracking-tight text-[var(--green)] [-webkit-text-stroke:0.01em_currentColor]">
				{title}
			</h1>
			<p class="text-[var(--textop)]">{place}</p>
		</div>

		<div class="flex flex-col gap-1 text-[var(--green)] lg:items-end lg:text-right">
			<p class="text-3xl font-medium [-webkit-text-stroke:0.02em_currentColor] lg:text-4xl">
				{price}{p.operation === "Alquiler" && <span class="text-base opacity-50"> /mes</span>}
			</p>
			{p.expensas && (
				<p class="text-[.9rem] opacity-50">
					Expensas {formatPrice(p.expensas, p.expensasCurrency || "ARS")}
				</p>
			)}
		</div>
	</div>
</div>

<script>
	const btn = document.getElementById("shared");
	const label = btn?.querySelector<HTMLElement>("[data-share-label]");

	btn?.addEventListener("click", async () => {
		if (navigator.share) {
			try {
				await navigator.share({ title: document.title, url: location.href });
			} catch {}
			return;
		}
		try {
			await navigator.clipboard.writeText(location.href);
			if (label) {
				label.textContent = "Link copiado";
				setTimeout(() => (label.textContent = "Compartir"), 2000);
			}
		} catch {}
	});
</script>