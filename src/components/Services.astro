---

const { t } = Astro.props;
---

<section data-services 
  class="bg-[#0d0d0d] px-10 py-20 text-[#f5f4f4]"
>
  <!-- HEADER -->
  <div>
    <h2
      style="--d: 100ms"
      class="reveal mt-6 text-5xl font-medium leading-none tracking-tight md:text-6xl lg:text-[10vw]"
    >
      {t.title}
    </h2>

    <p
      style="--d: 200ms"
      class="reveal ml-auto mt-8 max-w-lg text-base leading-relaxed md:text-lg"
    >
      {t.description}
      <span class="text-neutral-400">{t.descriptionRest}</span>
    </p>
  </div>

  <div class="mt-20 grid grid-cols-1 gap-10 lg:grid-cols-2">
    <!-- LISTA -->
    <div data-services-list class="flex flex-col overflow-hidden">
      {t.items.map((item, i) => (
        <a
          href={item.href}
          style={`--d: ${i * 100}ms`}
          class:list={[
            "reveal group block py-5 lg:py-6",
            i > 0 && "border-t border-[var(--bg)]/10",
            { active: i === 0 },
          ]}
        >
          <h3 class="text-[clamp(3rem,8vw,7.5rem)] font-medium leading-[0.95] tracking-tight transition-[translate,color] duration-500 group-hover:translate-x-3 lg:text-neutral-500 lg:group-[.active]:text-[var(--bg)] motion-reduce:transition-none">
            {item.title}
          </h3>

          <div class="grid grid-rows-[1fr] transition-[grid-template-rows,opacity] duration-500 ease-out motion-reduce:transition-none lg:grid-rows-[0fr] lg:opacity-0 lg:group-[.active]:grid-rows-[1fr] lg:group-[.active]:opacity-100">
            <div class="overflow-hidden">
              <p class="mt-3 max-w-sm text-sm leading-relaxed text-neutral-400 md:text-base">
                {item.description}
              </p>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- IMAGEN -->
    <div class="h-fit lg:sticky lg:top-24">
      <div data-reveal="mask" class="relative aspect-square max-w-md overflow-hidden bg-[#232323]">
        <img
          src="/dormitorio.png"
          alt=""
          width="600"
          height="600"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-services-list]").forEach((list) => {
    const rows = [...list.children];
    const activate = (row) =>
      rows.forEach((r) => r.classList.toggle("active", r === row));

    rows.forEach((row) => {
      row.addEventListener("mouseenter", () => activate(row));
      row.addEventListener("focus", () => activate(row));
    });
  });
</script>