---
import data from "../data/es.json";

const t = data.footer;
const whatsappHref = `https://wa.me/${t.contact.whatsapp.number}`;
---

<footer class="bg-[#060606] text-[var(--bg)]">
  <div class="px-10 py-16 md:py-20">

    <!-- PRINCIPAL -->
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-8">

      <!-- MARCA -->
      <div>
        <a href="/" class="text-xl font-medium tracking-tight uppercase [-webkit-text-stroke:0.02em_currentColor]">{t.brand}.</a>
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-[var(--bg)]/50">
          {t.description}
        </p>
      </div>

      <!-- EXPLORAR -->
      <div>
        <span class="text-xs uppercase tracking-widest opacity-40">
          {t.explore.title}
        </span>
        <nav aria-label={t.explore.title} class="mt-6 flex flex-col gap-3 text-sm">
          {
            t.explore.links.map((link) => (
              <a href={link.href} class="w-fit transition-opacity hover:opacity-50">
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <!-- ZONAS -->
      <div>
        <span class="text-xs uppercase tracking-widest opacity-40">
          {t.zones.title}
        </span>
        <nav aria-label={t.zones.title} class="mt-6 flex flex-col gap-3 text-sm">
          {
            t.zones.links.map((link) => (
              <a href={link.href} class="w-fit transition-opacity hover:opacity-50">
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <!-- CONTACTO -->
      <div>
        <span class="text-xs uppercase tracking-widest opacity-40">
          {t.contact.title}
        </span>

        <div class="mt-6 flex flex-col gap-3 text-sm">
          <address class="not-italic">{t.contact.address}</address>

          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="w-fit transition-opacity hover:opacity-50"
          >
            {t.contact.whatsapp.label} <span aria-hidden="true">↗</span>
          </a>

          <a
            href={`mailto:${t.contact.email}`}
            class="w-fit transition-opacity hover:opacity-50"
          >
            {t.contact.email}
          </a>

          {
            t.contact.social.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="w-fit transition-opacity hover:opacity-50"
              >
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- LEGAL: sin bordes, separado solo por espacio -->
    <div class="mt-20 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-2 text-xs text-[var(--bg)]/50">
        <p class="m-0">{t.license}</p>
        <p class="m-0">© {new Date().getFullYear()} {t.copyright}</p>
      </div>

      <a
        href={t.legal.privacyHref}
        class="text-xs text-[var(--bg)]/50 transition-colors hover:text-[var(--bg)]"
      >
        {t.legal.privacy}
      </a>
    </div>

  </div>
</footer>