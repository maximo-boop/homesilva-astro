---
import SearchComponent from '../components/Search.astro';
const { t } = Astro.props;
---

<section class="flex flex-col gap-5 mt-2 lg:flex-row min-h-[85vh]">

  <div class="@container flex flex-col justify-between lg:flex-1/3">

    <div class="p-5 bg-[var(--card)] flex-1 flex flex-col justify-between relative">
      <div>
        <p class="text-[var(--green)] text-[19cqw] leading-[1] tracking-tighter font-medium [-webkit-text-stroke:0.02em_currentColor]">
          {t.eyebrow}
        </p>
        <h1 class="text-[var(--textop)]">{t.title}</h1>
        <p class="text-[var(--textop)]">{t.description}</p>
      </div>

      <div>
        <SearchComponent labels={t.search} />
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute bottom-0 right-0 h-24 w-24 bg-[var(--bg)] [clip-path:polygon(100%_0,100%_100%,0_100%)]"
      ></div>
    </div>

    <a class="mt-5 group inline-flex items-center gap-2 text-[#0d0d0daa] hover:text-[var(--text2)] w-fit" href={t.cta.href}>
      {t.cta.label} 
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="group-hover:translate-x-1 transition-translate duration-200" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l14 0" /><path d="M15 16l4 -4" /><path d="M15 8l4 4" /></svg>
    </a>
  </div>

  <div class="lg:flex-1">
    <img
      src="/hero.png"
      alt=""
      class="h-full min-h-100 w-full object-cover"
    />
  </div>

</section>