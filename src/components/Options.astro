---
const { item, styles, active } = Astro.props;
const id = `submenu-${item.title}`;

const fade = 'transition-[opacity,background-color] duration-200';
const iconFade = 'transition-[opacity,transform] duration-200 group-hover:opacity-100';

const ui = styles
	? {
			li: 'w-full flex items-center gap-2 lg:gap-4',
			row: 'lg:overflow-hidden lg:gap-0 bg-[#ebeaea] w-full px-6 py-4 lg:p-0 text-nowrap lg:w-fit',
			link: 'lg:py-4 lg:px-6 lg:hover:bg-[#f5f4f4] text-lg',
			label: 'hidden',
			wrap: 'flex lg:h-full',
			list: 'flex text-nowrap gap-2 lg:gap-4',
			child: 'text-lg lg:text-base bg-[#ebeaea] py-4 px-6 hover:bg-[#f5f4f4]',
		}
	: {
			li: 'lg:flex',
			row: '',
			link: '',
			label: '',
			wrap: 'pt-2',
			list: 'hidden flex-col bg-[#ebeaea] text-nowrap p-2 min-w-full top-full left-0 lg:absolute lg:shadow-[0_0_10px_rgba(0,0,0,0.05)]',
			child: 'text-[.95rem] py-2 px-4 flex w-full text-start hover:bg-[#f5f4f4]',
		};
---

<li class={`text-[.95rem] relative menu z-10 ${ui.li}`}>
	<div class={`flex group items-center justify-between gap-2 ${ui.row}`}>
		<a
			href={item.url}
			aria-current={active ? 'page' : undefined}
			class={`${fade} group-hover:opacity-100 ${active ? 'opacity-100' : 'opacity-50'} ${ui.link}`}
		>{item.title}</a>

		<input
			id={item.title}
			type="checkbox"
			class="dropdown-toggle pointer-events-none absolute opacity-0"
			aria-label={`Abrir submenú de ${item.title}`}
		/>
		<label
			for={item.title}
			class={`cursor-pointer w-full lg:w-fit ${ui.label}`}
			aria-haspopup="true"
			aria-controls={id}
		>
			<span class="sr-only">Abrir submenú de {item.title}</span>
			<svg 
			xmlns="http://www.w3.org/2000/svg"
			class={`ml-auto ${iconFade} ${active ? 'opacity-100' : 'opacity-50'}`}
			focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" ><path d="M6 9l6 6l6 -6" /></svg>
		</label>
	</div>

	<div class={ui.wrap}>
		<ul id={id} class={`submenu ${ui.list}`}>
			{item.childrens.map((c, i) => (
				<li class="flex" style={`animation-delay: ${i * 40}ms`}>
					<a href={c.url} class={`${fade} opacity-50 hover:opacity-100 ${ui.child}`}>{c.title}</a>
				</li>
			))}
		</ul>
	</div>
</li>

<style>
	@keyframes submenu-in {
		from { opacity: 0; transform: translateY(-8px); }
	}
	@keyframes submenu-item {
		from { opacity: 0; transform: translateY(-4px); }
	}

	.menu:has(input:checked) .submenu,
	.menu:hover .submenu {
		display: flex;
	}

	@media (prefers-reduced-motion: no-preference) {
		.menu:has(input:checked) .submenu,
		.menu:hover .submenu {
			animation: submenu-in 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
		}
		.submenu li {
			animation: submenu-item 250ms ease-out backwards;
		}
	}
</style>

<script>
	document.addEventListener('click', (e) => {
		document
			.querySelectorAll<HTMLInputElement>('.dropdown-toggle:checked')
			.forEach((toggle) => {
				if (!toggle.closest('.menu')?.contains(e.target as Node)) toggle.checked = false;
			});
	});
</script>