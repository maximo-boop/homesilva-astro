---
import propiedades from "@/data/propiedades.json";
import { buildSearchIndex } from "@/scripts/utils.js";

const { labels } = Astro.props;
const any = labels.any ?? "Cualquiera";

const index = buildSearchIndex(propiedades, { exclude: ["miami-florida"] });

const operations = [
  { value: "venta", label: labels.operations.buy },
  { value: "alquiler", label: labels.operations.rent },
].filter((op) => index.operations.includes(op.value));

const fields = [
  { name: "type", ...labels.propertyType, options: index.types },
  { name: "location", ...labels.location, options: index.locations },
];
---

<form
  data-search
  data-combos={JSON.stringify(index.combos)}
  action="/propiedades/venta"
  method="get"
  class="flex flex-col text-[var(--bg)] mt-10 text-[.9rem] font-medium"
>
  <!-- OPERACIÓN -->
  <fieldset class="flex">
    <legend class="sr-only">{labels.operations.label}</legend>
    {
      operations.map((op, i) => (
        <label class="cursor-pointer">
          <input
            type="radio"
            name="operation"
            value={op.value}
            checked={i === 0}
            class="peer sr-only"
          />
          <span class="block font-medium w-30 p-3 px-4 text-center bg-[var(--bg)] text-[var(--textop)] peer-checked:bg-[var(--text)] peer-checked:text-[var(--bg)] peer-focus-visible:outline peer-focus-visible:outline-offset-2">
            {op.label}
          </span>
        </label>
      ))
    }
  </fieldset>

  <!-- PANEL -->
  <div class="flex w-full flex-col gap-6 bg-[var(--text)] pt-10 md:pt-0 md:pl-8 md:gap-0 md:w-fit md:flex-row md:items-center md:gap-0">

    <div class="flex flex-col px-5 md:px-0 gap-6 md:flex-row md:gap-18">
      {
        fields.map((field) => (
          <div data-field data-name={field.name} data-placeholder={field.placeholder} class="relative">
            <button
              type="button"
              data-trigger
              aria-expanded="false"
              aria-controls={`${field.name}-menu`}
              class="flex flex-col items-start w-full md:w-auto"
            >
              <span class="flex w-full items-center justify-between gap-4 md:w-auto md:justify-start">
                {field.label}
                <svg data-chevron aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M6 9l6 6l6 -6" /></svg>
              </span>
              <span data-value class="mt-[1px] text-[var(--bg)]/50">
                {field.placeholder}
              </span>
            </button>

            <input type="hidden" name={field.name} value="" />

            <ul
              id={`${field.name}-menu`}
              data-menu
              class="absolute left-0 top-full z-20 mt-3 max-h-64 min-w-56 overflow-y-auto bg-[var(--text)] md:mt-6"
            >
              {field.options.map((o) => (
                <li class="m-2">
                  <button
                    type="button"
                    data-option={o.value}
                    class="block w-full hover:bg-[var(--textop)] px-5 py-3 text-left text-[var(--bg)]/50 hover:text-[var(--bg)] focus-visible:text-[var(--bg)] aria-[current=true]:bg-[var(--textop)] aria-[current=true]:text-[var(--bg)]"
                  >
                    {o.label}
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- <div aria-hidden="true" class="hidden h-9 bg-[#f5f4f444] ml-14 w-[1.8px] md:block"></div> -->

    <button
      type="submit"
      aria-label={labels.submit}
      class="bg-[#314131] hover:bg-[#4a5d4a] inline-flex w-full text-[var(--bg)] items-center justify-center md:w-24 h-24 md:ml-8"
    >
      <svg

       width="26"
       height="26"
       viewBox="0 0 17.88525 17.885246"
       fill="none"
       stroke="currentColor"
       stroke-width="1.8"
       version="1.1"
       id="svg3"
       xmlns="http://www.w3.org/2000/svg"
       xmlns:svg="http://www.w3.org/2000/svg">
      <defs
         id="defs3" />
      <g
         id="g4"
         transform="translate(-1.837012,-1.8370151)">
        <g
           id="g3">
          <g
             id="g6"
             transform="translate(-0.162988,-0.16298802)">
            <g
               id="g5">
              <path
                 d="M 3,10 A 7,7 0 1 0 17,10 7,7 0 1 0 3,10"
                 id="path2" />
              <path
                 d="M 18.88525,18.88525 15,15"
                 id="path3" />
            </g>
          </g>
        </g>
      </g>
    </svg>


    </button>
  </div>
</form>
{
  labels.quick?.items?.length > 0 && (
    <nav aria-label={labels.quick.label} class="mt-5">
      <ul class="flex flex-wrap gap-2">
        {labels.quick.items.map((item) => (
          <li>
            <a
              href={item.href}
              class="group hover:bg-[#314131] bg-[var(--bg)] inline-flex items-center gap-2 px-4 py-3 text-[.9rem] font-medium text-[var(--text2)] transition-colors hover:text-[var(--bg)] focus-visible:bg-[var(--text)] focus-visible:text-[var(--bg)]"
            >
              {item.label}
              <svg xmlns="http://www.w3.org/2000/svg" class=" group-hover:translate-x-1 transition-translate duration-200" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l14 0" /><path d="M15 16l4 -4" /><path d="M15 8l4 4" /></svg>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  button {
    cursor: pointer;
  }
  /* Menú: cierra con fade + leve desplazamiento hacia arriba */
  [data-menu] {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0s linear 0.2s; /* se oculta recién al terminar el fade */
  }

  [data-open] [data-menu] {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 0.2s ease,
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      visibility 0s; /* aparece al instante, así el foco por teclado funciona */
  }

  /* Mobile: el desplegable se abre como modal centrado */
  @media (max-width: 767px) {
    [data-menu] {
      position: fixed;
      inset: 0;
      margin: auto;
      z-index: 210;
      height: fit-content;
      width: min(90vw, 26rem);
      max-height: 70dvh;
    }

    /* Fondo oscuro detrás del menú abierto */
    [data-open]::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 200;
      background: rgb(0 0 0 / 0.6);
    }

    /* La página de atrás no scrollea mientras está abierto */
    :global(body:has([data-search] [data-open])) {
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-menu] {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-search]").forEach((form) => {
    const fields = [...form.querySelectorAll<HTMLElement>("[data-field]")];
    const combos = JSON.parse(form.dataset.combos!).map((c: string) => c.split("|"));
    const COL: Record<string, number> = { operation: 0, type: 1, location: 2 };

    const menuOf = (f: HTMLElement) => f.querySelector("[data-menu]")!;
    const triggerOf = (f: HTMLElement) => f.querySelector<HTMLElement>("[data-trigger]")!;
    const isOpen = (f: HTMLElement) => f.hasAttribute("data-open");

    // ── Menús ────────────────────────────────────────
    const close = (f: HTMLElement, returnFocus = false) => {
      f.removeAttribute("data-open");
      triggerOf(f).setAttribute("aria-expanded", "false");
      if (returnFocus) triggerOf(f).focus();
    };

    const open = (f: HTMLElement, fromKeyboard: boolean) => {
      fields.forEach((o) => o !== f && close(o));
      f.setAttribute("data-open", "");
      triggerOf(f).setAttribute("aria-expanded", "true");

      if (fromKeyboard) {
        const target =
          menuOf(f).querySelector<HTMLElement>('[aria-current="true"]') ||
          menuOf(f).querySelector<HTMLElement>("[data-option]:not(:disabled)");
        target?.focus();
      }
    };

    // ── Datos ────────────────────────────────────────
    const state = () => Object.fromEntries(new FormData(form)) as Record<string, string>;

    // ¿Hay al menos una propiedad que cumpla estos valores?
    const exists = (sel: Record<string, string>) =>
      combos.some((c: string[]) => Object.entries(sel).every(([k, v]) => !v || c[COL[k]] === v));

    const setValue = (f: HTMLElement, value: string, text = "") => {
      f.querySelector<HTMLInputElement>('input[type="hidden"]')!.value = value;

      const label = f.querySelector<HTMLElement>("[data-value]")!;
      label.textContent = value ? text : f.dataset.placeholder!;
      label.classList.toggle("text-[var(--bg)]/50", !value);
      label.classList.toggle("text-[var(--bg)]", !!value);

      f.querySelectorAll<HTMLElement>("[data-option]").forEach((o) =>
        value && o.dataset.option === value
          ? o.setAttribute("aria-current", "true")
          : o.removeAttribute("aria-current")
      );
    };

    // Limpia lo que quedó sin resultados y bloquea las opciones que no llevan a ninguna propiedad
    const refresh = () => {
      const s = state();

      // Cada campo debe tener resultados con la operación elegida
      fields.forEach((f) => {
        const name = f.dataset.name!;
        if (s[name] && !exists({ operation: s.operation, [name]: s[name] })) {
          setValue(f, "");
          s[name] = "";
        }
      });

      // Tipo y localidad pueden existir por separado pero no juntos
      if (!exists(s)) {
        setValue(fields.find((f) => f.dataset.name === "location")!, "");
        s.location = "";
      }

      fields.forEach((f) => {
        const name = f.dataset.name!;
        f.querySelectorAll<HTMLButtonElement>("[data-option]").forEach((o) => {
          const v = o.dataset.option!;
          o.disabled = !exists({ ...s, [name]: v });
        });
      });
    };

    // ── Eventos ──────────────────────────────────────
    fields.forEach((f) => {
      const options = f.querySelectorAll<HTMLButtonElement>("[data-option]");

      triggerOf(f).addEventListener("click", (e) => {
        isOpen(f) ? close(f) : open(f, e.detail === 0); // detail 0: vino del teclado
      });

      options.forEach((o) =>
        o.addEventListener("click", () => {
          const selected = o.getAttribute("aria-current") === "true";
          setValue(f, selected ? "" : o.dataset.option!, o.textContent!.trim());
          refresh();
          close(f, true);
        })
      );

      menuOf(f).addEventListener("keydown", (e) => {
        const key = (e as KeyboardEvent).key;
        if (key !== "ArrowDown" && key !== "ArrowUp") return;
        e.preventDefault();

        const items = [...options].filter((o) => !o.disabled);
        const i = items.indexOf(document.activeElement as HTMLButtonElement);
        const next =
          key === "ArrowDown" ? items[i + 1] ?? items[0] : items[i - 1] ?? items[items.length - 1];
        next.focus();
      });

      f.addEventListener("focusout", (e) => {
        if (e.relatedTarget && !f.contains(e.relatedTarget as Node)) close(f);
      });
    });

    form.querySelectorAll('input[name="operation"]').forEach((r) =>
      r.addEventListener("change", refresh)
    );

    document.addEventListener("pointerdown", (e) => {
      fields.forEach((f) => {
        if (!f.contains(e.target as Node) || e.target === f) close(f);
      });
    });

    form.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const openField = fields.find(isOpen);
      if (openField) close(openField, true);
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const s = state();
      const path = exists(s)
        ? [s.operation, s.type, s.location].filter(Boolean)
        : [s.operation];
      location.assign(`/propiedades/${path.join("/")}`);
    });

    refresh();
  });
</script>