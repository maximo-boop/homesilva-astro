---
import "@/styles/global.css";
import data from "../data/es.json";

import Layout from '@/layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import FeaturedProperties from "../components/FeaturedProperties.astro";
import Services from "../components/Services.astro";
import Zones from "../components/Zones.astro";
import About from "../components/About.astro";
import Process from "../components/Process.astro";
import Appraisal from "../components/Appraisal.astro";
import Faq from "../components/Faq.astro";

const sample = {
  href: "/propiedades",
  imageAlt: "Terreno en Valle Hermoso",
  operation: "Venta",
  type: "Terreno",
  location: "Valle Hermoso",
  title: "Lote en esquina",
  features: ["450 m²", "Escritura", "Servicios"],
  price: "USD 45.000",
};
const items = Array.from({ length: 6 }, (_, i) => ({
  ...sample,
  title: `${sample.title} ${i + 1}`,
  image: 
    i===0 ? 'https://kkevijpywsidvjgujztg.supabase.co/storage/v1/object/public/property-photos/AR/publications/13097405/photo_1791459069673777274_30433576_medium.webp'
    : i===1 ? 'https://kkevijpywsidvjgujztg.supabase.co/storage/v1/object/public/property-photos/AR/publications/12173724/photo_1791399506521707667_27790911_medium.webp'
    : i===2 ? 'https://kkevijpywsidvjgujztg.supabase.co/storage/v1/object/public/property-photos/AR/publications/13128487/photo_1791860669771656439_41486926_medium.webp'
    : i===3 ? 'https://ik.imagekit.io/homesilva/departamento-en-sunny-isles-miami-florida/01.jpg'
    : i===4 ? 'https://ik.imagekit.io/homesilva/departamento-en-alta-cordoba-cordoba/01.webp'
    :'https://ik.imagekit.io/homesilva/departamento-en-chateau-carreras-cordoba/01.jpg'
}));
---

<Layout>
	<main class="flex flex-col ">
    <div class="flex flex-col gap-15 p-5 lg:p-12 pt-0 lg:pt-0 lg:pb-25">
  		<Hero t={data.hero} />
      <Stats t={data.stats} />
    </div>
    <div class="bg-[var(--bg3)] flex flex-col gap-30 p-5 lg:p-12 lg:pt-25 lg:pb-30">
  		<FeaturedProperties t={{ ...data.featured, items }} />
      <Services t={data.services} />
      <Zones t={data.zones} />
      <About t={data.about} />
    </div>
    <div class="flex flex-col gap-25 p-5 lg:p-12 lg:pt-30">
      <Process t={data.process} />
      <Appraisal t={data.appraisal} />
      <Faq t={data.faq} />
    </div>
	</main>
</Layout>

