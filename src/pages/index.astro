---
import "@/styles/global.css";
import data from "../data/es.json";
import propiedades from "../data/propiedades.json";

import Layout from '@/layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import FeaturedProperties from "../components/FeaturedProperties.astro";
import Services from "../components/Services.astro";
import Zones from "../components/Zones.astro";
import About from "../components/About.astro";
import Process from "../components/Process.astro";
import Appraisal from "../components/Appraisal.astro";
import Faq from "../components/Faq.astro";

import { buildZones } from "@/scripts/utils.js";

const zones = {
  ...data.zones,
  items: buildZones(propiedades, data.zones.featured, {
    limit: 6,
    images: data.zones.images,
    exclude: ["miami-florida"],
  })
};
---

<Layout>
	<main class="flex flex-col ">
    <div class="flex flex-col gap-15 p-5 lg:p-12 pt-0 lg:pt-0 lg:pb-25">
  		<Hero t={data.hero} />
      <Stats t={data.stats} />
    </div>
    <div class="bg-[var(--bg3)] flex flex-col gap-30 p-5 lg:p-12 lg:pt-25 lg:pb-30">
  		<FeaturedProperties t={data.featured} />
      <Services t={data.services} />
      <Zones t={zones} />
      <About t={data.about} />
    </div>
    <div class="flex flex-col gap-25 p-5 lg:p-12 lg:pt-30">
      <Process t={data.process} />
      <Appraisal t={data.appraisal} />
      <Faq t={data.faq} />
    </div>
	</main>
</Layout>

