---
import Layout from "@/layouts/Layout.astro";
import Formulario from "../components/Formulario.astro";
import data from "../data/es.json";

const t = data.contactPage;
const c = data.footer.contact;
const SITE = "https://homesilva.com.ar";
const pageUrl = `${SITE}${Astro.url.pathname}`;
const title = "Contacto | HomeSilva Inmobiliaria";
const description =
	"Escribinos por WhatsApp o email, o visitá nuestra oficina en Valle Hermoso. Te asesoramos para comprar, vender o alquilar en Córdoba y Sierras.";

const schema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "ContactPage",
			"@id": `${pageUrl}#page`,
			url: pageUrl,
			name: title,
			description,
			inLanguage: "es-AR",
			isPartOf: { "@id": `${SITE}/#website` },
			breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
			mainEntity: { "@id": `${SITE}/#agency` },
		},
		{
			"@type": "BreadcrumbList",
			"@id": `${pageUrl}#breadcrumb`,
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Inicio", item: SITE },
				{ "@type": "ListItem", position: 2, name: "Contacto", item: pageUrl },
			],
		},
	],
};
---

<Layout nofoot title={title} description={description}>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<main class="text-white ">
		<div class="grid grid-cols-1 lg:min-h-[70vh] lg:grid-cols-2">

			<!-- IMAGEN CON EL CONTENIDO ADENTRO -->
			<section
				data-reveal="mask"
				class="bg-[#e3e3e2] relative flex min-h-[28rem] flex-col justify-between overflow-hidden p-6 lg:p-10"
			>
				<img
					src={t.image.src}
					alt={t.image.alt ?? ""}
					loading="lazy"
					decoding="async"
					class="absolute inset-0 h-full w-full object-cover"
				/>
				<div aria-hidden="true" class="absolute inset-0 bg-black/35"></div>

				<div class="relative">
					<h1 class="m-0 text-[clamp(3rem,6.5vw,6.5rem)] font-medium leading-[0.9] tracking-tighter">
						{t.title}
					</h1>
					<p class="mt-6 max-w-sm text-[var(--bg)]/80 text-base leading-relaxed ">
						{t.description}
					</p>
				</div>

				<ul class="relative m-0 mt-12 flex list-none flex-col gap-5 p-0">
					<li>
						<span class=" text-xs  tracking-[0.2em] text-[var(--bg)]/80">
							{t.channels.whatsapp.label}
						</span>
						<a
							href={`https://wa.me/${c.whatsapp.number}`}
							target="_blank"
							rel="noopener noreferrer"
							class="mt-1 block w-fit text-xl font-medium tracking-tight transition-opacity hover:opacity-60"
						>
							{t.channels.whatsapp.cta} <span aria-hidden="true">↗</span>
						</a>
					</li>
					<li>
						<span class=" text-xs  tracking-[0.2em] text-[var(--bg)]/80">
							{t.channels.email.label}
						</span>
						<a
							href={`mailto:${c.email}`}
							class="mt-1 block w-fit text-xl font-medium tracking-tight transition-opacity hover:opacity-60"
						>
							{c.email}
						</a>
					</li>
					<li>
						<span class=" text-xs  tracking-[0.2em] text-[var(--bg)]/80">
							{t.channels.address.label}
						</span>
						<address class="mt-1 text-xl font-medium not-italic tracking-tight">
							{c.address}
						</address>
					</li>
				</ul>
			</section>

			<!-- FORMULARIO EN SU CONTENEDOR -->
			<section			
				class="p-6 lg:p-20 [&>form]:max-w-none text-[var(--text)]"
			>
				<Formulario interest={t.form.interest} />
			</section>

		</div>
	</main>
</Layout>