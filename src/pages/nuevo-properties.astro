---
import "@/styles/global.css";

---

<div class="min-h-screen bg-white text-neutral-900">

  <!-- HEADER -->
  <header class="h-20 border-b border-neutral-200 px-8 flex items-center justify-between">
    
    <!-- Logo -->
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 border-2 border-black flex items-center justify-center">
        <div class="w-3 h-3 border border-black rotate-45"></div>
      </div>

      <span class="text-sm font-bold tracking-tight">
        GRANDVIEW REALTY
      </span>
    </div>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-7 text-sm">
      <a href="#" class="hover:text-neutral-500">Apartments</a>
      <a href="#" class="hover:text-neutral-500">Services</a>
      <a href="#" class="hover:text-neutral-500">Help</a>
      <a href="#" class="hover:text-neutral-500">About us</a>
      <a href="#" class="hover:text-neutral-500">Blog</a>
    </nav>

    <button class="bg-black text-white text-sm px-5 py-2.5 ">
      Sign In
    </button>
  </header>


  <!-- MAIN LAYOUT -->
  <main class="flex min-h-[calc(100vh-80px)]">

  	<!-- Toggle de filtros (sin JS) -->
	<input type="checkbox" id="filters-toggle" class="peer/filters hidden" />

	<!-- Backdrop, solo mobile -->
	<label
		for="filters-toggle"
		class="hidden peer-checked/filters:block md:hidden fixed inset-0 bg-black/40 z-40"
	></label>

    <!-- SIDEBAR -->
    <aside class="fixed inset-y-0 left-0 z-50 w-[85%] max-w-[300px] bg-white border-r border-neutral-200 px-6 py-6 overflow-y-auto -translate-x-full transition-transform duration-300 ease-in-out peer-checked/filters:translate-x-0 md:relative md:z-auto md:w-[250px] md:max-w-none md:translate-x-0 md:shrink-0">
    <!-- <aside class="w-[250px] shrink-0 border-r border-neutral-200 px-6 py-6 overflow-y-auto"> -->

		<div class="flex items-center justify-between mb-4 md:hidden">
			<span class="text-sm font-semibold">Filtros</span>
			<label for="filters-toggle" class="text-lg leading-none cursor-pointer">✕</label>
		</div>

      <!-- Buy / Rent -->
      <div class="grid grid-cols-2 border border-neutral-300 overflow-hidden h-9">
        <button class="text-sm bg-white">
          Buy
        </button>

        <button class="text-sm bg-black text-white">
          Rent
        </button>
      </div>


      <!-- Results / Map -->
      <div class="flex items-center justify-between mt-6 mb-7">
        <span class="text-xs text-neutral-500">
          256 results
        </span>

        <label class="flex items-center gap-2 text-xs">
          Show on map

          <span class="relative inline-flex">
            <input type="checkbox" class="peer sr-only" checked />

            <span class="w-9 h-5 bg-neutral-200 peer-checked:bg-black transition"></span>

            <span class="absolute left-0.5 top-0.5 w-4 h-4 bg-white transition peer-checked:translate-x-4"></span>
          </span>
        </label>
      </div>


      <!-- RENTAL PERIOD -->
      <section class="mb-7">
        <h3 class="text-sm font-semibold mb-4">
          Rental period
        </h3>

        <div class="space-y-3">

          <label class="flex items-center gap-2 text-xs">
            <input
              type="checkbox"
              checked
              class="accent-black w-4 h-4"
            />
            Long term rent
          </label>

          <label class="flex items-center gap-2 text-xs">
            <input
              type="checkbox"
              class="accent-black w-4 h-4"
            />
            Shot term rent
          </label>

        </div>
      </section>


      <!-- PRICE -->
      <section class="mb-7">
        <h3 class="text-sm font-semibold mb-4">
          Price
        </h3>

        <!-- Fake range -->
        <div class="relative h-5 mb-3">

          <div class="absolute top-2 left-0 right-0 h-px bg-neutral-300"></div>

          <div class="absolute top-2 left-1 right-[35%] h-[2px] bg-black"></div>

          <span class="absolute top-0 left-0 w-4 h-4 bg-black border-2 border-white ring-1 ring-black"></span>

          <span class="absolute top-0 right-[32%] w-4 h-4 bg-black border-2 border-white ring-1 ring-black"></span>

        </div>

        <div class="grid grid-cols-2 gap-5">
          <input
            type="text"
            value="$280"
            class="w-full h-8 px-3 border border-neutral-300 text-xs"
          />

          <input
            type="text"
            value="$760"
            class="w-full h-8 px-3 border border-neutral-300 text-xs"
          />
        </div>
      </section>


      <!-- REAL ESTATE TYPE -->
      <section class="mb-7">
        <h3 class="text-sm font-semibold mb-4">
          Real estate type
        </h3>

        <div class="space-y-3">

          <label class="flex items-center gap-2 text-xs">
            <input type="checkbox" class="accent-black w-4 h-4" />
            Houses
          </label>

          <label class="flex items-center gap-2 text-xs">
            <input type="checkbox" class="accent-black w-4 h-4" />
            Condos
          </label>

          <label class="flex items-center gap-2 text-xs">
            <input type="checkbox" checked class="accent-black w-4 h-4" />
            Apartments
          </label>

          <label class="flex items-center gap-2 text-xs">
            <input type="checkbox" class="accent-black w-4 h-4" />
            Commercial
          </label>

        </div>
      </section>


      <!-- BEDROOMS -->
      <section class="mb-7">
        <h3 class="text-sm font-semibold mb-4">
          Bedrooms
        </h3>

        <div class="flex items-center gap-4">

          <label class="flex items-center gap-2 text-xs">
            <input type="checkbox" class="accent-black w-4 h-4" />
            1
          </label>

          <label class="flex items-center gap-2 text-xs">
            <input type="checkbox" checked class="accent-black w-4 h-4" />
            2
          </label>

          <label class="flex items-center gap-2 text-xs">
            <input type="checkbox" class="accent-black w-4 h-4" />
            3
          </label>

          <label class="flex items-center gap-2 text-xs whitespace-nowrap">
            <input type="checkbox" class="accent-black w-4 h-4" />
            4 and more
          </label>

        </div>
      </section>


      <!-- BATHROOM -->
      <section class="mb-7">
        <h3 class="text-sm font-semibold mb-4">
          Bathroom
        </h3>

        <div class="grid grid-cols-3 gap-1">

          <button class="h-8 text-xs bg-black text-white">
            Any
          </button>

          <button class="h-8 text-xs border border-neutral-300">
            Combined
          </button>

          <button class="h-8 text-xs border border-neutral-300">
            Separate
          </button>

        </div>
      </section>


      <!-- VIEW -->
      <section>
        <h3 class="text-sm font-semibold mb-4">
          View
        </h3>

        <div class="grid grid-cols-3 gap-1">

          <button class="h-8 text-xs bg-black text-white">
            Any
          </button>

          <button class="h-8 text-xs border border-neutral-300">
            Courtyard
          </button>

          <button class="h-8 text-xs border border-neutral-300">
            Street
          </button>

        </div>
      </section>

    </aside>


    <!-- CONTENT -->
    <section class="flex-1 min-w-0 px-4 sm:px-6 md:px-8 py-6">
    <!-- <section class="flex-1 min-w-0 px-8 py-6"> -->

      <!-- MAP -->
      <div class="w-full h-[200px] sm:h-[240px] md:h-[290px] bg-neutral-100 border border-neutral-200 relative overflow-hidden">
      <!-- <div class="w-full h-[290px] bg-neutral-100 border border-neutral-200 relative overflow-hidden"> -->

        <!-- Placeholder map -->
        <div class="absolute inset-0 bg-neutral-200 flex items-center justify-center">
          <span class="text-sm text-neutral-500">
            MAP
          </span>
        </div>

        <!-- Fake price markers -->
        <div class="absolute top-8 left-[12%] bg-black text-white text-xs px-4 py-2 rounded-lg">
          $478
        </div>

        <div class="absolute top-12 left-[42%] bg-black text-white text-xs px-4 py-2 rounded-lg">
          $659
        </div>

        <div class="absolute top-20 right-[14%] bg-black text-white text-xs px-4 py-2 rounded-lg">
          $512
        </div>

        <div class="absolute bottom-12 left-[8%] bg-black text-white text-xs px-4 py-2 rounded-lg">
          $698
        </div>

        <div class="absolute bottom-16 left-[31%] bg-black text-white text-xs px-4 py-2 rounded-lg">
          $525
        </div>

        <div class="absolute bottom-10 right-[18%] bg-black text-white text-xs px-4 py-2 rounded-lg">
          $280
        </div>

      </div>


      <!-- TOOLBAR -->
      <div class="flex flex-wrap items-center justify-between gap-3 py-3 md:h-12 md:py-0">
      <!-- <div class="h-12 flex items-center justify-between"> -->

      	<label
		    for="filters-toggle"
		    class="md:hidden flex items-center gap-2 text-xs border border-neutral-300 px-3 py-1.5 cursor-pointer"
		  >
		    Filtros
		  </label>

        <!-- View buttons -->
        <div class="flex items-center gap-4">

          <button class="w-5 h-5 grid grid-cols-2 gap-0.5">
            <span class="bg-black rounded-[1px]"></span>
            <span class="bg-black rounded-[1px]"></span>
            <span class="bg-black rounded-[1px]"></span>
            <span class="bg-black rounded-[1px]"></span>
          </button>

          <button class="flex flex-col gap-1">
            <span class="w-4 h-px bg-neutral-400"></span>
            <span class="w-4 h-px bg-neutral-400"></span>
            <span class="w-4 h-px bg-neutral-400"></span>
          </button>

        </div>


        <!-- Sort -->
        <div class="flex items-center gap-2 text-xs text-neutral-500">
          <span>Sort by</span>

          <button class="text-black flex items-center gap-1">
            Price
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-down"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M6 9l6 6l6 -6" /></svg>
          </button>
        </div>

      </div>


      <!-- PROPERTY GRID -->
      <!-- <div class="grid grid-cols-3 gap-x-4 gap-y-8"> -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-8">

        <!-- CARD 1 -->
        <div>
          <div class="aspect-[1.35/1] bg-neutral-200"></div>

          <div class="flex justify-between items-center mt-2">
            <div>
              <span class="font-semibold text-base">$478</span>
              <span class="text-[10px] text-neutral-500"> /month</span>
            </div>

            <button class="text-xl leading-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-heart"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" /></svg>
            </button>
          </div>

          <p class="text-xs mt-1 truncate">
            Putuo, Dahude Road, No. 1618
          </p>

          <p class="text-[10px] text-neutral-500 mt-2">
            2 rooms · 1 bathroom · 2 floor
          </p>
        </div>


        <!-- CARD 2 -->
        <div>
          <div class="aspect-[1.35/1] bg-neutral-200"></div>

          <div class="flex justify-between items-center mt-2">
            <div>
              <span class="font-semibold text-base">$512</span>
              <span class="text-[10px] text-neutral-500"> /month</span>
            </div>

            <button class="text-xl leading-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-heart"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" /></svg>
            </button>
          </div>

          <p class="text-xs mt-1 truncate">
            Lujiazbang Central Road, No. 1054
          </p>

          <p class="text-[10px] text-neutral-500 mt-2">
            2 rooms · 1 bathroom · 2 floor
          </p>
        </div>


        <!-- CARD 3 -->
        <div>
          <div class="aspect-[1.35/1] bg-neutral-200"></div>

          <div class="flex justify-between items-center mt-2">
            <div>
              <span class="font-semibold text-base">$698</span>
              <span class="text-[10px] text-neutral-500"> /month</span>
            </div>

            <button class="text-xl leading-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-heart"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" /></svg>
            </button>
          </div>

          <p class="text-xs mt-1 truncate">
            Ri Hui Er Cun, Xu Hui Qu Road, No. 74-75
          </p>

          <p class="text-[10px] text-neutral-500 mt-2">
            2 rooms · 1 bathroom · 2 floor
          </p>
        </div>


        <!-- CARD 4 -->
        <div>
          <div class="aspect-[1.35/1] bg-neutral-200"></div>

          <div class="flex justify-between items-center mt-2">
            <div>
              <span class="font-semibold text-base">$560</span>
              <span class="text-[10px] text-neutral-500"> /month</span>
            </div>

            <button class="text-xl leading-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-heart"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" /></svg>
            </button>
          </div>

          <p class="text-xs mt-1 truncate">
            Shanghai, Pudong District
          </p>

          <p class="text-[10px] text-neutral-500 mt-2">
            3 rooms · 2 bathrooms · 4 floor
          </p>
        </div>


        <!-- CARD 5 -->
        <div>
          <div class="aspect-[1.35/1] bg-neutral-200"></div>

          <div class="flex justify-between items-center mt-2">
            <div>
              <span class="font-semibold text-base">$620</span>
              <span class="text-[10px] text-neutral-500"> /month</span>
            </div>

            <button class="text-xl leading-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-heart"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" /></svg>
            </button>
          </div>

          <p class="text-xs mt-1 truncate">
            Huangpu District, Shanghai
          </p>

          <p class="text-[10px] text-neutral-500 mt-2">
            2 rooms · 1 bathroom · 3 floor
          </p>
        </div>


        <!-- CARD 6 -->
        <div>
          <div class="aspect-[1.35/1] bg-neutral-200"></div>

          <div class="flex justify-between items-center mt-2">
            <div>
              <span class="font-semibold text-base">$740</span>
              <span class="text-[10px] text-neutral-500"> /month</span>
            </div>

            <button class="text-xl leading-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-heart"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" /></svg>
            </button>
          </div>

          <p class="text-xs mt-1 truncate">
            Jing'an District, Shanghai
          </p>

          <p class="text-[10px] text-neutral-500 mt-2">
            3 rooms · 2 bathrooms · 5 floor
          </p>
        </div>

      </div>

    </section>

  </main>

</div>