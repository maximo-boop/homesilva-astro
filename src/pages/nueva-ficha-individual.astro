---
import "@/styles/global.css";
---

<div class="min-h-screen bg-white text-neutral-900">

  <!-- HEADER -->
  <header class="h-20 border-b border-neutral-200 px-4 sm:px-8 flex items-center justify-between">

    <!-- Logo -->
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 border-2 border-black flex items-center justify-center">
        <div class="w-3 h-3 border border-black rotate-45"></div>
      </div>

      <span class="text-sm font-bold tracking-tight hidden sm:inline">
        GRANDVIEW REALTY
      </span>
    </div>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-7 text-sm">
      <a href="#" class="border-b border-black">Apartments</a>
      <a href="#" class="hover:text-neutral-500">Services</a>
      <a href="#" class="hover:text-neutral-500">Help</a>
      <a href="#" class="hover:text-neutral-500">About us</a>
      <a href="#" class="hover:text-neutral-500">Blog</a>
    </nav>

    <button class="bg-black text-white text-sm px-5 py-2.5">
      Sign In
    </button>
  </header>


  <!-- MAIN -->
  <main class="max-w-6xl mx-auto px-4 sm:px-8 py-6">

    <!-- GO BACK -->
    <button class="flex items-center gap-1.5 text-sm bg-neutral-100 px-4 py-2 mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6l6 6" /></svg>
      Go back
    </button>


    <!-- GALLERY -->
    <div class="grid grid-cols-1 md:grid-cols-[1.4fr_0.9fr_0.9fr] gap-2 h-[300px] sm:h-[380px] md:h-[420px]">

      <!-- Main photo -->
      <div class="h-full bg-neutral-200 overflow-hidden">
        <img
          src="https://images.unsplash.com/photo-1616594039964-ae9021a400a0?w=1200&q=80"
          alt="Living room"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Two stacked photos -->
      <div class="hidden md:grid grid-rows-2 gap-2 h-full">
        <div class="bg-neutral-200 overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=80"
            alt="Kitchen"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="bg-neutral-200 overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=800&q=80"
            alt="Bedroom"
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <!-- Third photo -->
      <div class="hidden md:block h-full bg-neutral-200 overflow-hidden">
        <img
          src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=800&q=80"
          alt="Dining area"
          class="w-full h-full object-cover"
        />
      </div>

    </div>


    <!-- DETAILS -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr] gap-10 mt-8">

      <!-- LEFT COLUMN -->
      <div>

        <div class="flex items-center gap-1.5 text-sm text-neutral-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-8 -5.373 -8 -12a8 8 0 0 1 16 0c0 6.627 -8 12 -8 12z" /><circle cx="12" cy="9" r="2.5" /></svg>
          Lujiabang Road, No. 1054
        </div>

        <div class="mt-3">
          <span class="text-4xl font-semibold">$512</span>
          <span class="text-sm text-neutral-500"> /month</span>
        </div>

        <a href="#" class="inline-block text-xs underline mt-2">
          Pricing details and terms
        </a>

        <!-- Stats -->
        <div class="grid grid-cols-4 gap-4 mt-7 pb-7 border-b border-neutral-200">
          <div>
            <span class="text-xl font-semibold">74</span>
            <span class="text-xs text-neutral-500 block">m²</span>
          </div>
          <div>
            <span class="text-xl font-semibold">3</span>
            <span class="text-xs text-neutral-500 block">beds</span>
          </div>
          <div>
            <span class="text-xl font-semibold">2</span>
            <span class="text-xs text-neutral-500 block">baths</span>
          </div>
          <div>
            <span class="text-xl font-semibold">16</span>
            <span class="text-xs text-neutral-500 block">floor</span>
          </div>
        </div>

        <!-- Agent + CTA -->
        <div class="flex flex-col sm:flex-row items-stretch gap-3 mt-7">

          <div class="flex items-center gap-3 border border-neutral-300 px-4 py-2.5 flex-1">
            <img
              src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=100&q=80"
              alt="Agent"
              class="w-9 h-9 object-cover"
            />
            <div class="text-sm">
              <span class="text-neutral-500">Agent: </span>
              <span class="font-medium">Maddie Molina</span>
            </div>
          </div>

          <button class="bg-black text-white text-sm px-6 py-2.5 flex-1 sm:flex-none">
            Send a request
          </button>

        </div>

      </div>


      <!-- RIGHT COLUMN -->
      <div>

        <!-- Save / Share -->
        <div class="flex justify-end gap-3 mb-6">
          <button class="flex items-center gap-2 text-sm border border-neutral-300 px-4 py-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" /></svg>
            Save
          </button>

          <button class="flex items-center gap-2 text-sm border border-neutral-300 px-4 py-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-6" /><path d="M16 6l-4 -4l-4 4" /><path d="M12 2v13" /></svg>
            Share
          </button>
        </div>

        <h2 class="text-base font-semibold">About apartment</h2>

        <p class="text-sm text-neutral-600 leading-relaxed mt-3">
          Discover your ideal urban retreat in this stunning 3-bedroom, 2-bathroom
          apartment, perfectly situated in the vibrant heart of downtown. Bright
          open-plan living, floor-to-ceiling windows, and premium finishes throughout.
        </p>

        <a href="#" class="inline-block text-xs underline mt-3 mb-6">
          Full description
        </a>

        <!-- Amenities -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-3 gap-x-4 pt-6 border-t border-neutral-200">

          <div class="flex items-center gap-2 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10" /></svg>
            Equipped kitchen
          </div>

          <div class="flex items-center gap-2 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10" /></svg>
            Wi-Fi
          </div>

          <div class="flex items-center gap-2 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10" /></svg>
            Lake view
          </div>

          <div class="flex items-center gap-2 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10" /></svg>
            Free parking
          </div>

          <div class="flex items-center gap-2 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10" /></svg>
            Swimming pool
          </div>

          <div class="flex items-center gap-2 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10" /></svg>
            Light
          </div>

          <div class="flex items-center gap-2 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10" /></svg>
            Air conditioning
          </div>

          <div class="flex items-center gap-2 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10" /></svg>
            Gym
          </div>

        </div>

      </div>

    </div>

  </main>

</div>
