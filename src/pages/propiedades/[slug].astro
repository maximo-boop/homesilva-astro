---
import Layout from "@/layouts/Layout.astro";
import propiedades from "@/data/propiedades.json";
import PropertyHeader from "@/components/property/PropertyHeader.astro";
import PropertyCard from "@/components/PropertyCard.astro";
import CarouselControls from "@/components/CarouselControls.astro";
import Gallery from "@/components/property/Gallery.astro";
import Form from "@/components/Formulario.astro";
import { buildTitle, buildDescription, formatPrice, distance, toSlug, toPlural } from "@/scripts/utils.js";

export async function getStaticPaths() {
	return propiedades.map((p) => ({
		params: { slug: p.slug },
		props: { propiedad: p },
	}));
}

const { propiedad: p } = Astro.props;

// ── Datos base ──────────────────────────────────
const c = Object.fromEntries(
	Object.entries(p.characteristics ?? {}).map(([k, v]) => [k, v === 0 && k !== "antiguedad" ? null : v])
);

const antiguedad = (v) =>
	v == null ? null : typeof v === "number" ? (v === 0 ? "A estrenar" : `${v} años`) : v;

const hasPrice = p.price > 0;
const price = hasPrice ? `${p.toPrice ? "Desde " : ""}${formatPrice(p.price, p.currency)}` : "Precio a consultar";
const suffix = hasPrice && p.operation === "Alquiler" ? " /mes" : "";
const title = p.title || buildTitle(p);
const m2 = (n) => `${Number(n).toLocaleString("es-AR")} m²`;
const isLand = ["Terreno", "Lote"].includes(p.type);

const expensas = p.expensas ? formatPrice(p.expensas, p.expensasCurrency || "ARS") : null;

const facts = [
	["Superficie total", c.superficie_total != null && (c.superficie_total_max != null ? `${m2(c.superficie_total)} – ${m2(c.superficie_total_max)}` : m2(c.superficie_total))],
	["Superficie cubierta", c.superficie_cubierta != null && m2(c.superficie_cubierta)],
	["Ambientes", c.ambientes],
	["Dormitorios", c.dormitorios],
	["Baños", c.banos],
	["Cocheras", c.cochera],
	["Antigüedad", antiguedad(c.antiguedad)],
].filter(([, v]) => v != null && v !== false && v !== 0);

const area = isLand ? c.superficie_total : c.superficie_cubierta || c.superficie_total;
const resumen = [
	!isLand && c.dormitorios && `${c.dormitorios} dorm.`,
	!isLand && c.banos && `${c.banos} ${c.banos === 1 ? "baño" : "baños"}`,
	area && m2(area),
]
	.filter(Boolean)
	.join(" · ");

const detalles = (p.detalles ?? []).filter(Boolean);
const servicios = (p.services ?? []).filter(Boolean);
const descripcion = p.description && p.description !== "---" ? p.description : null;

const h2 = "text-2xl font-medium text-[var(--green)] [-webkit-text-stroke:0.01em_currentColor] lg:text-3xl";
const section = "flex flex-col gap-6 border-t border-[color:var(--bg4)] pt-8";

// ── Relacionadas: cercanas (hasta 10 km), primero mismo tipo y operación ──
const RADIUS_KM = 25; // hasta qué distancia busca
const MAX_RELATED = 12;

const resSimilares = p.position?.lat != null
	? propiedades
			.filter((o) => o.id !== p.id && o.active !== false && o.position?.lat != null)
			.map((o) => ({
				...o,
				distance: distance(p.position.lat, p.position.lng, o.position.lat, o.position.lng),
				same: o.type === p.type && o.operation === p.operation ? 0 : o.operation === p.operation ? 1 : 2,
			}))
			.filter((o) => o.distance <= RADIUS_KM)
			.sort((a, b) => a.same - b.same || a.distance - b.distance)
			.slice(0, MAX_RELATED)
	: [];

const op = p.operation.toLowerCase();
const typeSlug = toPlural(p.type.toLowerCase());
const locSlug = toSlug(p.locality.toLowerCase());
const listingHref = `/propiedades/${op}/${typeSlug}/${locSlug}`;

// ── SEO y schema ────────────────────────────────
const SITE = "https://homesilva.com.ar";
const pageUrl = `${SITE}/propiedades/${p.slug}`;

const clip = (s = "", n = 160) => {
	const t = s.replace(/\s+/g, " ").trim();
	return t.length <= n ? t : t.slice(0, n).replace(/\s+\S*$/, "") + "…";
};

const seo = {
	title: p.title ? `${p.title} | HomeSilva` : `${buildTitle(p, true)} | HomeSilva`,
	description: p.description !== "---" ? p.description : buildDescription(p),
	canonical: pageUrl,
	ogImage: p.images?.[0] || `${SITE}/og-default.jpg`,
};

const images = (p.images ?? []).filter(Boolean);
const prop = (name, value, unitCode) =>
	value != null ? [{ "@type": "PropertyValue", name, value, ...(unitCode ? { unitCode } : {}) }] : [];

// Terrenos, locales y hostel van como Place: no tienen ambientes ni dormitorios "de vivienda"
const residenceType = ["Casa", "Cabaña"].includes(p.type) ? "House"
	: p.type === "Departamento" ? "Apartment"
	: ["Terreno", "Lote", "Local", "Oficina", "Hostel", "Hotel"].includes(p.type) ? "Place"
	: "Accommodation";
const isPlace = residenceType === "Place";

// Cualquier característica nueva del JSON se agrega sola
const knownKeys = ["superficie_total", "superficie_total_max", "superficie_cubierta", "ambientes", "dormitorios", "banos", "cochera", "antiguedad"];
const label = (k) => {
	const t = k.replace(/_/g, " ");
	return t.charAt(0).toUpperCase() + t.slice(1);
};
const extraProps = Object.entries(c)
	.filter(([k, v]) => !knownKeys.includes(k) && v != null)
	.map(([k, value]) => ({
		"@type": "PropertyValue",
		name: label(k),
		value,
		...(k.startsWith("superficie") ? { unitCode: "MTK" } : {}),
	}));

const isNew = detalles.some((d) => d.toLowerCase().includes("estrenar"));
const priceSpecification = [
	...(op === "alquiler"
		? [{ "@type": "UnitPriceSpecification", price: p.price, priceCurrency: p.currency, unitCode: "MON" }]
		: []),
	...(p.expensas != null
		? [{ "@type": "UnitPriceSpecification", name: "Expensas", price: p.expensas, priceCurrency: p.expensasCurrency ?? "ARS", unitCode: "MON" }]
		: []),
];

const listingNode = {
	"@type": "RealEstateListing",
	"@id": `${pageUrl}#listing`,
	url: pageUrl,
	name: title,
	description: seo.description,
	inLanguage: "es-AR",
	...(images.length ? { image: images } : {}),
	...(p.publicated && p.publicated !== "0" ? { datePosted: p.publicated } : {}),
	...(op === "alquiler" && p.leaseMonths
		? { leaseLength: { "@type": "QuantitativeValue", value: p.leaseMonths, unitCode: "MON" } }
		: {}),
	isPartOf: { "@id": `${SITE}/#website` },
	breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
	mainEntity: { "@id": `${pageUrl}#property` },
	offers: {
		"@type": p.toPrice ? "AggregateOffer" : "Offer",
		url: pageUrl,
		...(hasPrice
		? { priceCurrency: p.currency, ...(p.toPrice ? 
		{ lowPrice: p.price, highPrice: p.toPrice } : { price: p.price }) }
		: {}),
		...(priceSpecification.length ? { priceSpecification } : {}),
		itemCondition: isNew ? "https://schema.org/NewCondition" : "https://schema.org/UsedCondition",
		availability: p.active ? "https://schema.org/InStock" : "https://schema.org/SoldOut",
		seller: { "@type": "RealEstateAgent", "@id": `${SITE}/#agency`, name: "HomeSilva", url: SITE },
	},
};

const propertyNode = {
	"@type": residenceType,
	"@id": `${pageUrl}#property`,
	name: title,
	address: {
		"@type": "PostalAddress",
		...(p.direction ? { streetAddress: p.barrio ? `${p.direction}, ${p.barrio}` : p.direction } : {}),
		addressLocality: p.locality,
		addressRegion: p.region ?? "Córdoba",
		addressCountry: p.country ?? "AR",
	},
	...(p.position?.lat && p.position?.lng
		? { geo: { "@type": "GeoCoordinates", latitude: p.position.lat, longitude: p.position.lng } }
		: {}),
	// floorSize y los ambientes solo existen en viviendas (House, Apartment, Accommodation)
	...(!isPlace && c.superficie_cubierta != null
		? { floorSize: { "@type": "QuantitativeValue", value: c.superficie_cubierta, unitCode: "MTK" } }
		: {}),
	...(!isPlace && c.ambientes != null ? { numberOfRooms: c.ambientes } : {}),
	...(!isPlace && c.dormitorios != null ? { numberOfBedrooms: c.dormitorios } : {}),
	...(!isPlace && c.banos != null ? { numberOfBathroomsTotal: c.banos } : {}),
	additionalProperty: [
		...prop("Superficie total", c.superficie_total, "MTK"),
		...prop("Superficie total máxima", c.superficie_total_max, "MTK"),
		...(isPlace ? prop("Superficie cubierta", c.superficie_cubierta, "MTK") : []),
		...(isPlace ? [...prop("Ambientes", c.ambientes), ...prop("Dormitorios", c.dormitorios), ...prop("Baños", c.banos)] : []),
		...prop("Cocheras", c.cochera),
		...prop("Antigüedad", c.antiguedad, typeof c.antiguedad === "number" ? "ANN" : undefined),
		...extraProps,
	],
	amenityFeature: [...detalles, ...servicios].map((name) => ({
		"@type": "LocationFeatureSpecification",
		name,
		value: true,
	})),
};

const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
const breadcrumbNode = {
	"@type": "BreadcrumbList",
	"@id": `${pageUrl}#breadcrumb`,
	itemListElement: [
		["Inicio", SITE],
		["Propiedades", `${SITE}/propiedades`],
		[p.operation, `${SITE}/propiedades/${op}`],
		[cap(toPlural(p.type)), `${SITE}/propiedades/${op}/${typeSlug}`],
		[p.locality, `${SITE}${listingHref}`],
	].map(([name, item], i) => ({ "@type": "ListItem", position: i + 1, name, item })),
};

const schema = { "@context": "https://schema.org", "@graph": [listingNode, propertyNode, breadcrumbNode] };
---

<Layout
	title={seo.title}
	description={clip(seo.description)}
	canonical={seo.canonical}
	image={seo.ogImage}
	noindex={!p.active}
	displayWhsp
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

	<main class="sk p-5 lg:p-12 lg:pt-5">

		<div class="sk-wrap">
			<PropertyHeader p={p} />
		</div>

		<div class="sk-wrap">
			<Gallery images={p.images} alt={title} status={!p.active ? p.status : undefined} />
		</div>

		<div class="sk-wrap sk-body gap-[2.5rem] lg:gap-5">

			<article class="sk-article">
				{facts.length > 0 && (
					<section class={section}>
						<h2 class={h2}>Características principales</h2>
						<dl class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-3">
							{facts.map(([label, value]) => (
								<div class="flex flex-col gap-1">
									<dt class="text-[.9rem] text-[var(--textop)]">{label}</dt>
									<dd class="text-xl text-[var(--green)]">{value}</dd>
								</div>
							))}
						</dl>
					</section>
				)}

				{detalles.length > 0 && (
					<section class={section}>
						<h2 class={h2}>Detalles de la propiedad</h2>
						<ul class="grid grid-cols-2 gap-x-6 gap-y-4 text-[var(--text2)] lg:grid-cols-3">
							{detalles.map((d) => (
								<li class="flex items-center gap-3">
									<span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 bg-[var(--moss)]"></span>
									{d}
								</li>
							))}
						</ul>
					</section>
				)}

				{descripcion && (
					<section class={section}>
						<h2 class={h2}>Descripción</h2>
						<input type="checkbox" id="desc-toggle" class="peer sr-only" />
						<p class="line-clamp-8 max-w-3xl whitespace-pre-line text-[var(--text2)] peer-checked:line-clamp-none">
							{descripcion}
						</p>
						<label for="desc-toggle" class="w-fit cursor-pointer underline underline-offset-4 transition-opacity hover:opacity-70 peer-checked:hidden">
							Ver descripción completa
						</label>
						<label for="desc-toggle" class="hidden w-fit cursor-pointer underline underline-offset-4 transition-opacity hover:opacity-70 peer-checked:block">
							Ver menos
						</label>
					</section>
				)}

				{servicios.length > 0 && (
					<section class={section}>
						<h2 class={h2}>Servicios</h2>
						<ul class="grid grid-cols-2 gap-x-6 gap-y-4 text-[var(--text2)] lg:grid-cols-3">
							{servicios.map((s) => (
								<li class="flex items-center gap-3">
									<span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 bg-[var(--moss)]"></span>
									{s}
								</li>
							))}
						</ul>
					</section>
				)}

				<section class={section}>
					<h2 class={h2}>Ubicación</h2>
					<p class="text-[var(--textop)]">{[p.direction, p.barrio, p.locality].filter(Boolean).join(", ")}</p>

					{p.position?.lat && p.position?.lng && (
						<iframe
							src={`https://maps.google.com/maps?q=${p.position.lat},${p.position.lng}&z=15&output=embed`}
							width="100%"
							height="400"
							loading="lazy"
							class="block h-80 w-full bg-[var(--card)] lg:h-[28rem]"
							title={`Ubicación de ${title}`}
						></iframe>
					)}
				</section>
			</article>

			<aside class="sk-aside bg-[var(--card)]">
				<input type="checkbox" id="contactarme" class="peer sr-only lg:hidden" aria-label="Abrir formulario de consulta" />

				<!-- Mobile: barra fija -->
				<div class="flex items-center justify-between gap-4 peer-checked:hidden lg:hidden">
					<div class="flex flex-col leading-tight text-[var(--green)]">
						<span class="text-lg font-medium">{price}{suffix}</span>
						{expensas && <span class="text-xs opacity-50">Expensas {expensas}</span>}
					</div>
					<label for="contactarme" class="cursor-pointer bg-[var(--green)] px-6 py-3 font-medium text-[var(--bg)]">
						Consultar
					</label>
				</div>

				<!-- Desktop: siempre visible. Mobile: solo con la barra abierta -->
				<div class="hidden flex-col gap-2 peer-checked:flex lg:flex max-lg:mx-auto max-lg:w-full max-lg:max-w-md">
					<span class="w-fit bg-[var(--moss-light)] px-3 py-1 text-[.9rem] font-medium text-[var(--moss-pale)] [-webkit-text-stroke:0.02em_currentColor]">
						{p.operation} · {p.type}
					</span>
					<div class="flex items-start justify-between gap-2 text-[var(--green)]">
						<div class="flex flex-col gap-1">
							<p class="text-3xl font-medium [-webkit-text-stroke:0.02em_currentColor]">
								{price}{suffix && <span class="text-base opacity-50">{suffix}</span>}
							</p>
							{expensas && <p class="text-[.9rem] opacity-50">Expensas {expensas}</p>}
							{resumen && <p class="text-[.9rem] text-[var(--textop)]">{resumen}</p>}
						</div>
						<label for="contactarme" class="cursor-pointer text-[.9rem] underline underline-offset-4 lg:hidden">Cerrar</label>
					</div>

					<h2 class="text-lg font-medium text-[var(--green)]">Consultar por esta propiedad</h2>

					<Form titulo={`[${p.id}] ${title}`} url={p.slug} slug/>
				</div>
			</aside>
		</div>

		{resSimilares.length > 0 && (
			<div class="sk-wrap pb-20 lg:pb-0 mt-10">
				<section
					data-carousel
					aria-roledescription="carrusel"
					aria-labelledby="similares-title"
					class="overflow-x-clip text-[var(--text2)]"
				>
					<div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
						<h2
							id="similares-title"
							class="max-w-xl text-5xl font-medium leading-[1.1] text-[var(--green)] [-webkit-text-stroke:0.01em_currentColor] lg:text-[3.5rem]"
						>
							Propiedades similares
						</h2>
						<a href={listingHref} class="transition-opacity hover:opacity-70">
							Ver más en {p.locality}
						</a>
					</div>

					<div class="mt-10">
						<ul
							data-carousel-track
							class="-mt-6 mb-4 flex snap-x snap-mandatory gap-[var(--gap)] overflow-x-auto overscroll-x-contain pt-6 pb-6 [--gap:1.25rem] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
						>
							{resSimilares.map((item) => (
								<li class="shrink-0 grow-0 basis-[calc((100%-var(--gap))/1.2)] snap-start md:basis-[calc((100%-2*var(--gap))/2.5)] lg:basis-[calc((100%-3*var(--gap))/3.5)]">
									<PropertyCard item={item} />
								</li>
							))}
						</ul>

						<CarouselControls prev="Propiedad anterior" next="Propiedad siguiente" class="ml-auto w-fit" />
					</div>
				</section>
			</div>
		)}

	</main>
</Layout>

<style>
	.sk { display: flex; flex-direction: column; gap: 1.5rem; }
	.sk-wrap { width: 100%; max-width: 1700px; margin-inline: auto; }
	.sk-box {
		display: flex; align-items: center; justify-content: center; text-align: center;
		background: var(--card); color: var(--textop); font-size: .8rem;
		flex: none; /* nunca se aplastan */
	}
	.sk-header { height: 176px; }

	/* Galería: mobile = una foto; desktop = 1 grande + 4 chicas */
	.sk-gallery { display: grid;  }
	.sk-gallery .big { aspect-ratio: 4 / 3; }

	/* Ficha */
	.sk-body { display: flex; align-items: flex-start; }
	.sk-article { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2.5rem; }

	/* Relacionadas */
	.sk-related { display: grid; grid-template-columns: 1fr; gap: 2.5rem 1.25rem; }
	.sk-third { display: none; }

	/* Base (mobile): barra fija abajo */
	.sk-aside {
		position: fixed; left: 0; right: 0; bottom: 0; z-index: 15;
		padding: .75rem 1.25rem max(.75rem, env(safe-area-inset-bottom));
		border-top: 1px solid var(--bg4);
	}

	@media (max-width: 1023px) {
		/* Con el formulario abierto, ocupa toda la pantalla */
		.sk-aside:has(input:checked) {
			inset: 0; z-index: 110; overflow-y: auto;
			padding: 1.25rem; border-top: 0;
		}
		:global(html:has(#contactarme:checked)) { overflow: hidden; }
	}

	@media (min-width: 640px) {
		.sk-related { grid-template-columns: 1fr 1fr; }
	}
	
	@media (min-width: 1024px) {
		.sk { gap: 2rem; padding-bottom: 5rem; }
		.sk-header { height: 208px; }

		.sk-aside {
			position: sticky;
			top: calc(var(--sticky-top, 4.8rem) + 1.25rem);
			/* dejá acá el width que ya elegiste */
			width: 24rem;
			flex: none;
			max-height: calc(100dvh - var(--sticky-top, 4.8rem) - 2.5rem);
			overflow-y: auto;
			padding: 1.75rem;
			z-index: auto;
			border-top: 0;
			transition: top .3s, max-height .3s;
		}

		.sk-gallery {
			grid-template-columns: 3fr 1fr 1fr;
			grid-template-rows: 1fr 1fr;
			height: 80vh;
		}

		.sk-gallery .big { grid-row: span 2; aspect-ratio: auto; }

		.sk-related { grid-template-columns: repeat(3, 1fr); }
		.sk-third { display: flex; }
	}
</style>