---
import Layout from "../../layouts/Layout.astro";
import propiedades from "../../data/propiedades.json";
import PropertiesLayout from "../../components/properties/PropertiesLayout.astro";
import { EXCHANGE_RATE, buildTitle, toSlug, toPlural, matches, ITEMS_PER_PAGE } from "../../scripts/utils.js";
import { buildListingMeta } from "../../scripts/listingMeta.js";

export function getStaticPaths() {
	const paths = new Set();

	propiedades.forEach((p) => {
		const operacion = p.operation.toLowerCase();
		const tipo = toPlural(p.type.toLowerCase());
		const localidad = toSlug(p.locality);

		[
			operacion, tipo, localidad,
			`${operacion}/${tipo}`, `${operacion}/${localidad}`, `${tipo}/${localidad}`,
			`${operacion}/${tipo}/${localidad}`,
		].forEach((path) => paths.add(path));
	});

	// '' = raíz (/propiedades). Páginas 2, 3... de cada combinación
	const paginadas = ["", ...paths].flatMap((path) => {
		const segs = path ? path.split("/") : [];
		const total = Math.ceil(propiedades.filter((p) => matches(p, segs)).length / ITEMS_PER_PAGE);
		return Array.from({ length: Math.max(total - 1, 0) }, (_, i) =>
			`${path ? path + "/" : ""}page/${i + 2}`
		);
	});

	return [undefined, ...paths, ...paginadas].map((filtros) => ({ params: { filtros } }));
}

// ── URL ──────────────────────────────────────────
const { filtros } = Astro.params;
const segmentos = filtros?.split("/") ?? [];
const pageIndex = segmentos.indexOf("page");
const page = pageIndex !== -1 ? Number(segmentos[pageIndex + 1]) : 1;
const filtrosReales = pageIndex !== -1 ? segmentos.slice(0, pageIndex) : segmentos;

const items = propiedades.filter((p) => matches(p, filtrosReales));
const start = (page - 1) * ITEMS_PER_PAGE;
const itemsPP = items.slice(start, start + ITEMS_PER_PAGE);
const totalP = Math.ceil(items.length / ITEMS_PER_PAGE);

// ── Filtros ──────────────────────────────────────
const uniq = (key) => [...new Set(propiedades.map((p) => p[key]))];

const filters = [
	{ id: 1, title: "Operación", slug: "operacion", options: uniq("operation") },
	{ id: 2, title: "Propiedad", slug: "tipo", options: uniq("type") },
	{ id: 3, title: "Localidad", slug: "localidad", options: uniq("locality") },
];

const ars = (n) => ({ label: `$${n.toLocaleString("es-AR")}`, value: n });
const usd = (n) => ({ label: `U$D ${n.toLocaleString("es-AR")}`, value: n * EXCHANGE_RATE.usdToArs });
const precios = [ars(50000), ars(100000), ars(500000), ars(1000000), usd(50000), usd(100000), usd(150000), usd(200000)];

const queryFilters = [
	{ id: 1, title: "Habitaciones", slug: "habitaciones", options: [1, 2, 3, 4, 5] },
	{ id: 2, title: "Baños", slug: "banos", options: [1, 2, 3, 4] },
	{ id: 3, title: "Precio máximo", slug: "precioMax", options: precios },
	{ id: 4, title: "Precio mínimo", slug: "precioMin", options: precios.slice(0, 6) },
];

const urlParams = {
	operacion: filtrosReales.find((s) => filters[0].options.map((o) => o.toLowerCase()).includes(s)),
	tipo: filtrosReales.find((s) => filters[1].options.map((o) => toPlural(o.toLowerCase())).includes(s)),
	localidad: filtrosReales.find((s) => filters[2].options.map((o) => toSlug(o.toLowerCase())).includes(s)),
};

const operacionLabel = urlParams.operacion
	? urlParams.operacion.charAt(0).toUpperCase() + urlParams.operacion.slice(1)
	: null;
const tipoLabel = urlParams.tipo
	? items.find((p) => toPlural(p.type.toLowerCase()) === urlParams.tipo)?.type ??
	  urlParams.tipo.charAt(0).toUpperCase() + urlParams.tipo.slice(1)
	: null;
const localidadLabel = urlParams.localidad
	? propiedades.find((p) => toSlug(p.locality) === urlParams.localidad)?.locality
	: null;

// ── SEO ──────────────────────────────────────────
const { titulo, tituloSEO: tituloBase, description } = buildListingMeta(items, {
	operacionLabel, tipoLabel, localidadLabel,
});

const tituloSEO = page > 1
	? tituloBase.replace(" | HomeSilva", ` - Página ${page} | HomeSilva`)
	: tituloBase;
const descriptionSEO = page > 1 ? `${description} Página ${page}.` : description;

const BASE = "https://homesilva.com.ar/propiedades";
const unico = (fn) => {
	const valores = new Set(items.map(fn));
	return valores.size === 1 ? [...valores][0] : null;
};
const segsCanonicos = items.length
	? [
			urlParams.operacion ?? unico((p) => p.operation.toLowerCase()),
			urlParams.tipo ?? unico((p) => toPlural(p.type.toLowerCase())),
			urlParams.localidad ?? unico((p) => toSlug(p.locality)),
	  ].filter(Boolean)
	: filtrosReales;

const urlFor = (n) => [BASE, ...segsCanonicos, ...(n > 1 ? ["page", n] : [])].join("/");

const basePath = ["/propiedades", ...filtrosReales].join("/");


// Primer párrafo, cortado en una palabra entera
const excerpt = (s = "", max = 140) => {
	const t = s.split("\n")[0].trim();
	return t.length <= max ? t : t.slice(0, max).replace(/\s+\S*$/, "") + "…";
};
// Solo lo que usan las cards y el mapa. Antes viajaban descripciones e imágenes completas.
const toLite = (p) => ({
	id: p.id, slug: p.slug, title: p.title, type: p.type, operation: p.operation,
	locality: p.locality, barrio: p.barrio, direction: p.direction,
	price: p.price, currency: p.currency, toPrice: p.toPrice,
	publicated: p.publicated, position: p.position,
	characteristics: p.characteristics,
	expensas: p.expensas,
	excerpt: excerpt(p.description),
	images: p.images?.slice(0, 1) ?? [],
});

const canonicalURL = urlFor(page);
const prevURL = page > 1 ? urlFor(page - 1) : null;
const nextURL = page < totalP ? urlFor(page + 1) : null;

const SITE = "https://homesilva.com.ar";
const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);

// Nombre legible de cada segmento de la URL
const labelOf = (seg) =>
	items.find((p) => p.operation.toLowerCase() === seg)?.operation ??
	(items.find((p) => toPlural(p.type.toLowerCase()) === seg) && cap(seg)) ??
	items.find((p) => toSlug(p.locality) === seg)?.locality ??
	cap(seg);

// Cada tramo apunta a una página que existe (getStaticPaths genera todos los prefijos)
const crumbs = [
	["Inicio", SITE],
	["Propiedades", BASE],
	...segsCanonicos.map((seg, i) => [labelOf(seg), [BASE, ...segsCanonicos.slice(0, i + 1)].join("/")]),
];

const schema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "CollectionPage",
			"@id": `${canonicalURL}#page`,
			url: canonicalURL,
			name: titulo,
			description: descriptionSEO,
			inLanguage: "es-AR",
			isPartOf: { "@id": `${SITE}/#website` },
			breadcrumb: { "@id": `${canonicalURL}#breadcrumb` },
			mainEntity: { "@id": `${canonicalURL}#list` },
		},
		{
			"@type": "ItemList",
			"@id": `${canonicalURL}#list`,
			numberOfItems: items.length,
			itemListElement: itemsPP.map((p, i) => ({
				"@type": "ListItem",
				position: start + i + 1,
				url: `${BASE}/${p.slug}`,
				name: p.title || buildTitle(p),
			})),
		},
		{
			"@type": "BreadcrumbList",
			"@id": `${canonicalURL}#breadcrumb`,
			itemListElement: crumbs.map(([name, item], i) => ({
				"@type": "ListItem",
				position: i + 1,
				name,
				item,
			})),
		},
	],
};
---

<Layout title={tituloSEO} canonical={canonicalURL} description={descriptionSEO} listing>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />
	{prevURL && <link rel="prev" href={prevURL} slot="head" />}
	{nextURL && <link rel="next" href={nextURL} slot="head" />}

	<main class="flex flex-col gap-4 pb-20 bg-[#EFEEEE]">

		<div class="flex flex-col gap-2 mb-2 mt-5 px-5">
		    <h1 class="max-w-2xl font-medium leading-[1.2] tracking-tight text-[var(--green)]">
		      {titulo}
		    </h1>
		    <p id="count" aria-live="polite" class="text-[var(--textop)]">
				{items.length} {items.length === 1 ? "propiedad" : "propiedades"}
			</p>
		</div>

		<PropertiesLayout
			filters={filters}
			urlParams={urlParams}
			titulo={titulo}
			description={description}
			items={items.map(toLite)}
			itemsPP={itemsPP.map(toLite)}
			basePath={basePath}
			currentP={page}
			totalP={totalP}
		/>

		<p class="max-w-2xl mx-5 text-sm leading-relaxed text-[var(--text)] sm:text-base">
	      {description}
	    </p>
	</main>
</Layout>