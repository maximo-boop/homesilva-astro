---
import LegalLayout from "@/layouts/LegalLayout.astro";
import data from "../data/es.json";

const { privacy } = data;
const { email } = data.footer.contact;

// {email} se reemplaza por el del footer: se cambia en un solo lugar
const sections = privacy.sections.map((s) => ({
  ...s,
  body: s.body.replaceAll("{email}", email),
}));
---

<LegalLayout {...privacy} sections={sections} />