---
import Layout from "./Layout.astro";

const { metaTitle, description, title, updated, sections } = Astro.props;
---

<Layout title={metaTitle} description={description}>
  <main class="px-5 pb-20 pt-40 text-[var(--text)] lg:px-12">
    <div class="mx-auto w-full max-w-[1400px]">
      <header class="reveal mb-16 md:mb-24">
        <h1 class="max-w-[900px] text-[clamp(44px,7vw,112px)] font-medium leading-[0.92] tracking-[-0.06em]">
          {title}
        </h1>
        <p class="mt-6 text-base text-[var(--textop)]">{updated}</p>
      </header>

      <div>
        {sections.map((s, i) => (
          <section
            class="reveal grid grid-cols-1 gap-4 border-t border-[var(--text)]/15 py-10 md:grid-cols-[1fr_2fr] md:gap-16 md:py-14"
            style={`--d: ${i * 60}ms`}
          >
            <h2 class="flex items-baseline gap-4 self-start text-[clamp(22px,2.4vw,34px)] font-medium leading-[1.05] tracking-[-0.04em] md:sticky md:top-32">
              <span class="text-sm tracking-normal text-[var(--textop)]">
                {String(i + 1).padStart(2, "0")}
              </span>
              {s.title}
            </h2>
            <p
              class="max-w-xl text-base leading-relaxed text-[var(--textop)] [&_a]:text-[var(--text)] [&_a]:underline [&_a]:underline-offset-4"
              set:html={s.body}
            />
          </section>
        ))}
      </div>
    </div>
  </main>
</Layout>