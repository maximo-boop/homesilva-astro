---
import "@/styles/global.css";
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
const { title, description, image, canonical, displayWhsp, noindex, nofoot=false, listing=false } = Astro.props;

const SITE = "https://homesilva.com.ar";
const cities = ["Córdoba", "Valle Hermoso", "Villa Giardino", "Tantí", "La Falda", "Cosquín", "Villa Carlos Paz", "La Cumbre", "Huerta Grande"];
const sameAs = [
	"https://www.google.com/maps/place/Bienes+Ra%C3%ADces+Silva/@-31.1269526,-64.4828261,15z/data=!4m7!3m6!1s0x942d83ae98de68cf:0x38f5ae4b6c8e8772!8m2!3d-31.1279607!4d-64.4834592!10e1!16s%2Fg%2F11zy0s75v1",
];

const siteSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "RealEstateAgent",
			alternateName: "Bienes Raíces Silva",
			"@id": `${SITE}/#agency`,
			name: "HomeSilva",
			url: SITE,
			logo: `${SITE}/logo.png`,
			image: `${SITE}/og-default.png`,
			telephone: "+5493517062465",
			email: "consultas.brsilva@gmail.com",
			description: "Servicios inmobiliarios de compra y venta de propiedades en Córdoba y Sierras de Córdoba.",
			address: {
				"@type": "PostalAddress",
				streetAddress: "Roque Sáenz Peña 171",
				addressLocality: "Valle Hermoso",
				addressRegion: "Córdoba",
				addressCountry: "AR",
			},
			geo: { "@type": "GeoCoordinates", latitude: -31.1279607, longitude: -64.4834592 },
			openingHoursSpecification: {
				"@type": "OpeningHoursSpecification",
				dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
				opens: "09:00",
				closes: "21:00",
			},
			areaServed: [
				{ "@type": "AdministrativeArea", name: "Sierras de Córdoba" },
				...cities.map((name) => ({
					"@type": "City",
					name,
					containedInPlace: { "@type": "AdministrativeArea", name: "Córdoba" },
				})),
			],
			employee: {
				"@type": "Person",
				name: "Domingo Cayetano Silva",
				jobTitle: "Corredor Inmobiliario Matriculado",
				identifier: {
					"@type": "PropertyValue",
					name: "Matrícula profesional",
					value: "M.P. 045879 - 054237 - 013508",
				},
			},
			...(sameAs.length ? { sameAs } : {}),
		},
		{
			"@type": "WebSite",
			"@id": `${SITE}/#website`,
			url: SITE,
			name: "HomeSilva",
			inLanguage: "es-AR",
			publisher: { "@id": `${SITE}/#agency` },
		},
	],
};
---

<!doctype html>
<html lang="es-AR" class="scroll-smooth">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-3J5JW3RFQR"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-3J5JW3RFQR');
		</script>
		<link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="google-site-verification" content="S6m5SHxH881aog6vt2eLfbKNrTjpdaKe-SZW4Iu0DfU" />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
		<meta name="theme-color" content="#f5f4f4" />
		<meta name="author" content="HomeSilva" />
		<title>{title || 'Compra y venta de propiedades en Córdoba y Las Sierras | HomeSilva'}</title>
		<meta name="description" content={description || "Comprá, vendé o alquilá propiedades en Córdoba y Sierras con respaldo profesional. Casas, departamentos, terrenos y cabañas en Valle Hermoso, La Falda, Carlos Paz y más. Corredor matriculado, 15+ años de experiencia."} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		
		<link rel="canonical" href={canonical || Astro.url.href} />
		<meta name="generator" content={Astro.generator} />
		<!-- Open Graph -->
		<meta property="og:title" content={title || 'Compra y venta de propiedades en Córdoba y Las Sierras | HomeSilva'} />
		<meta property="og:description" content={description || "Ofrecemos servicios inmobiliarios personalizados de compra y venta de propiedades en la Provincia de Córdoba. Contáctanos para encontrar tu propiedad ideal."} />
		<meta property="og:image" content={image || 'https://homesilva.com.ar/og-default.png'} />
		<meta property="og:type" content='website' />
		<meta property="og:url" content={canonical || Astro.url.href} />
		<meta property="og:locale" content="es_AR" />
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<slot name="head" />

		<script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
	</head>
	<body>

		<Header listing={listing} />
		<slot />
		{!nofoot && <Footer />}
    	<div class="pointer-events-none fixed inset-x-0 top-0 z-50 h-5 bg-[#f5f4f4]"></div>
<!-- 
    	<a href="https://wa.me/5493517062465" aria-label="Contactar con un corredor inmobiliario por WhatsApp" target="_blank" class={`${displayWhsp ? 'hidden lg:inline' : ''} flex items-center justify-center whsp fixed right-5 bottom-5 bg-green-400 w-fit p-4 shadow-[0_0_10px_rgba(0,0,0,0.15)] hover:bg-green-500 transition-bg rounded-full rounded-br-none ease duration-150`}>
			<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" /><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" /></svg>
		</a> -->

		<script>
	      import "../scripts/reveal.js";
	    </script>
	</body>
</html>

<style>

	html {
		overflow-x: hidden;
	}

	html,
	body {
		background: var(--bg);
	}

	.whsp {
		transform: translate(0, 200%);
		animation: whsp-entry .6s cubic-bezier(.34, 1.56,.64,1) forwards;
		animation-delay: .75s;
		z-index: 90;
	}

	@keyframes whsp-entry {
		from {
			transform: translate(0, 100%);
			scale: .8;
			opacity: 0;
		}
		to {
			opacity: 1;
			transform: translate(0, 0);
			scale: 1;
		}
	}

</style>

